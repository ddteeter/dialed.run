#!/bin/sh
# The branch-wide rung of the tool-agnostic guardrail floor, and the companion
# to `.githooks/pre-commit`.
#
# pre-commit scopes the analyzers to the STAGED files, so committing stays fast
# however long the branch runs. That leaves exactly one gap: a commit can break
# something in a file it does not itself touch -- deleting the test that was
# killing a mutant elsewhere, say. This hook closes it by re-checking the whole
# branch diff once, before anything leaves the machine.
#
# Activate with:
#   git config core.hooksPath .githooks
# `guardrails init --apply` and `guardrails install-hooks` do that for you --
# UNLESS core.hooksPath already points at another hooks directory, which they
# will not overwrite. In that case add `sh .githooks/pre-push` to the pre-push
# hook you already have.
#
# There is no lock here. Mutation testing is what thrashes a machine running
# several agent worktrees, so the machine-wide mutation lock lives inside the
# gate, around the stryker run alone (`guardrails-core/src/mutation-lock.ts`),
# on every rung that runs it. A push with nothing to mutate never queues, and
# a gate that did wait its whole wait exits 75 (EX_TEMPFAIL), which is worded
# below apart from a block, because waiting is not a violation.
cli="./node_modules/guardrails-core/dist/cli.mjs"

# The preflight below re-enters this hook under the gate lock, with this set.
# It runs CI's first job and exits; git's refs on stdin are not read here.
if [ "${GUARDRAILS_PREFLIGHT:-}" = 1 ]; then
  for step in "npm run build" "npm test" "npm run diagrams:check"; do
    echo "guardrails: preflight: $step" >&2
    $step >&2 || {
      echo "guardrails: push blocked — '$step' failed. CI's first job runs it too." >&2
      exit 1
    }
  done
  exit 0
fi
# See .githooks/pre-commit: an uninstalled checkout is said as such, and still
# blocks.
[ -f "$cli" ] || {
  echo "guardrails: push blocked — guardrails-core is not installed in this checkout. Run 'npm ci' here, then push again." >&2
  exit 1
}

# CI parity, before the gate (owner, 2026-11-23). These are the checks CI's
# "Lint, typecheck, test, build" job runs that the gate does not; a lane that
# skipped one spent a two-hour CI lap finding out. They run under the
# machine-wide gate lock, released before the gate takes it again (owner,
# 2026-11-24): two full test suites side by side timed out DOM tests and
# blocked pushes for nothing. A push that only
# deletes refs (every local sha zero) runs none of them. `pr-ready` tells
# lanes not to run them again by hand before shipping. Git exports GIT_DIR
# and GIT_INDEX_FILE to hooks, and a test that runs git in a temp repo with
# the inherited env would otherwise write to this repo (core.bare, the index).
refs=$(cat)
pushes_commits=no
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) pushes_commits=yes ;;
  esac
done <<EOF
$refs
EOF
if [ "$pushes_commits" = yes ]; then
  lock="$HOME/.guardrails-gate.lock"
  unset_git="env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY GUARDRAILS_PREFLIGHT=1"
  echo "guardrails: preflight: waiting for the gate lock ($lock)" >&2
  if command -v lockf >/dev/null 2>&1; then
    lockf -k "$lock" $unset_git sh "$0" </dev/null || exit 1
  elif command -v flock >/dev/null 2>&1; then
    flock "$lock" $unset_git sh "$0" </dev/null || exit 1
  else
    echo "guardrails: push blocked — neither lockf nor flock is installed, so the preflight cannot take the gate lock." >&2
    exit 1
  fi
fi

node "$cli" gate --mode=push
status=$?

if [ "$status" -eq 75 ]; then
  echo "guardrails: gave up waiting for the gate lock — the mutation lock stayed busy for the whole wait." >&2
  echo "guardrails: push again to re-queue (in the background if you can); never bypass it with --no-verify." >&2
  exit 1
fi

if [ "$status" -ne 0 ]; then
  echo "guardrails: push blocked — resolve violations or run 'guardrails verify'." >&2
  exit 1
fi

# The sanction budget: every `Stryker disable` / exemption in the diff must
# match a keyed grant in guardrails.config.json. CI runs this as its own step
# after `gate --mode=ci`, and nothing local did, so a copied directive passed
# every local gate and failed CI an hour later. It takes a tenth of a second,
# so it runs after the gate.
node "$cli" sanctions-check || {
  echo "guardrails: push blocked — a sanction in this diff has no grant in guardrails.config.json." >&2
  exit 1
}
