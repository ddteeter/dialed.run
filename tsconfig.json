{
  "include": ["**/*.ts", "**/*.tsx"],
  // Read-only import archives (CLAUDE.md). The design handoff now ships a
  // reference `.tsx` — a prototype to port, not code to compile, and it
  // would fail the gates on sight. eslint already ignores both.
  "exclude": ["design/", "plan/"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    // ES2024.Promise, granularly, for `Promise.withResolvers`: eslint's
    // `unicorn/prefer-promise-with-resolvers` requires it, so without the
    // lib entry the two rules contradict each other and the only way out
    // is a suppression. Just the one API, not the whole ES2024 surface.
    //
    // ES2023.Array is here for the same reason and by the same rule:
    // `unicorn/no-array-sort` requires `toSorted`, and `sort` mutates in
    // place — which is a real bug waiting on a shared table, not a style
    // preference. workerd and Node both have it; only tsc did not.
    "lib": [
      "ES2022",
      "ES2023.Array",
      "ES2024.Promise",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["./worker-configuration.d.ts", "node", "vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
