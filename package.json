{
  "name": "dialed",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port ${PORT:-3000}",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "premutate": "rm -rf .stryker-tmp",
    "mutate": "node -e \"const {execFileSync} = require('node:child_process');const {rmSync} = require('node:fs');for (const scope of require('./stryker.conf.json').mutate) {console.log('=== ' + scope);rmSync('reports/stryker-incremental.json', {force: true});execFileSync('npx', ['stryker', 'run', '--mutate', scope], {stdio: 'inherit'});}\"",
    "postmutate": "rm -rf .stryker-tmp",
    "e2e": "playwright test --project=e2e",
    "demo": "DEMO_SLOWMO=1800 playwright test --project=demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "guardrails-core install-hooks",
    "db:generate:core": "drizzle-kit generate --config drizzle-core.config.ts",
    "db:generate:weather": "drizzle-kit generate --config drizzle-weather.config.ts",
    "db:migrate:local:core": "wrangler d1 migrations apply dialed-core --local",
    "db:migrate:local:weather": "wrangler d1 migrations apply dialed-weather --local",
    "verify": "node ./node_modules/guardrails-core/dist/cli.mjs verify"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@garmin/fitsdk": "^21.214.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "toucan-js": "^4.1.1",
    "ulidx": "^2.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "fallow": "^3.23.0",
    "guardrails-core": "https://github.com/ddteeter/agentic-guardrails-scaffolding/releases/download/v0.2.0/guardrails-core-0.2.0.tgz",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  },
  "license": "AGPL-3.0-only",
  "description": "A virtual wardrobe for runners: log what you wore, on which run, in which weather.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ddteeter/dialed.run.git"
  },
  "engines": {
    "node": "^24 || >=26"
  }
}
