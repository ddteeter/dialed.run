{
  "name": "dialed",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port ${PORT:-3000}",
    "generate-routes": "tsr generate",
    "stage:mediapipe": "tsx scripts/stage-mediapipe.ts",
    "generate:open-source": "tsx scripts/open-source-list.ts",
    "prebuild": "npm run stage:mediapipe",
    "build": "vite build",
    "postbuild": "npm run generate:open-source && npm run check:bundle",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "premutate": "rm -rf .stryker-tmp reports/mutation",
    "modules:pin": "tsx scripts/module-shape.ts",
    "mutate": "node -e \"const {execFileSync} = require('node:child_process');for (const scope of require('./stryker.conf.json').mutate) {console.log('=== ' + scope);execFileSync('npx', ['stryker', 'run', '--mutate', scope], {stdio: 'inherit'});}\"",
    "postmutate": "rm -rf .stryker-tmp",
    "e2e": "playwright test --project=e2e",
    "demo": "DEMO_SLOWMO=250 playwright test --project=demo",
    "postdemo": "npm run demo:mux",
    "demo:mux": "tsx scripts/demo-mux.ts",
    "walkthroughs": "DEMO_SLOWMO=800 playwright test --project=walkthrough --project=walkthrough-phone",
    "postwalkthroughs": "npm run demo:mux",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run lint:lockfile",
    "lint:lockfile": "lockfile-lint",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "guardrails-core install-hooks",
    "db:generate:core": "node -e \"const a=process.argv.slice(1);if(!a.some((x,i)=>/^--name=[a-z0-9_]+$/.test(x)||(x==='--name'&&/^[a-z0-9_]+$/.test(a[i+1]||'')))){console.error('Name the migration for what it does to the schema: npm run db:generate:core -- --name=add_run_idempotency_key (see CLAUDE.md, Schema changes).');process.exit(1);}require('node:child_process').execFileSync('npx',['drizzle-kit','generate','--config','drizzle-core.config.ts',...a],{stdio:'inherit'});\" --",
    "db:generate:weather": "node -e \"const a=process.argv.slice(1);if(!a.some((x,i)=>/^--name=[a-z0-9_]+$/.test(x)||(x==='--name'&&/^[a-z0-9_]+$/.test(a[i+1]||'')))){console.error('Name the migration for what it does to the schema: npm run db:generate:weather -- --name=add_run_idempotency_key (see CLAUDE.md, Schema changes).');process.exit(1);}require('node:child_process').execFileSync('npx',['drizzle-kit','generate','--config','drizzle-weather.config.ts',...a],{stdio:'inherit'});\" --",
    "db:generate:ops": "node -e \"const a=process.argv.slice(1);if(!a.some((x,i)=>/^--name=[a-z0-9_]+$/.test(x)||(x==='--name'&&/^[a-z0-9_]+$/.test(a[i+1]||'')))){console.error('Name the migration for what it does to the schema: npm run db:generate:ops -- --name=add_run_idempotency_key (see CLAUDE.md, Schema changes).');process.exit(1);}require('node:child_process').execFileSync('npx',['drizzle-kit','generate','--config','drizzle-ops.config.ts',...a],{stdio:'inherit'});\" --",
    "db:migrate:local:core": "wrangler d1 migrations apply dialed-core --local",
    "db:migrate:local:weather": "wrangler d1 migrations apply dialed-weather --local",
    "db:migrate:local:ops": "wrangler d1 migrations apply dialed-ops --local",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "garmin:check": "tsx scripts/garmin-check.ts",
    "plan-survey": "tsx scripts/plan-survey.ts",
    "docs:deltas": "sh scripts/design-deltas.sh",
    "e2e:ci": "sh scripts/e2e-ci.sh",
    "ship": "node ./node_modules/guardrails-core/dist/cli.mjs ship",
    "verify": "node ./node_modules/guardrails-core/dist/cli.mjs verify",
    "eval": "tsx eval/run.ts",
    "eval:photos": "tsx eval/photos/run.ts",
    "pretest": "npm run stage:mediapipe",
    "worktrees:prune": "sh scripts/worktrees-prune.sh",
    "generate:grafana": "tsx scripts/grafana-vitals.ts",
    "track": "tsx scripts/track.ts",
    "diagrams": "likec4 start docs/diagrams",
    "diagrams:audit": "sh scripts/diagram-audit.sh",
    "diagrams:check": "tsx scripts/diagram-structure.ts --check && likec4 validate --max-warnings 0 docs/diagrams && likec4 format --check docs/diagrams",
    "diagrams:format": "likec4 format docs/diagrams",
    "diagrams:generate": "tsx scripts/diagram-structure.ts",
    "diagrams:record": "sh scripts/diagram-record.sh",
    "diagrams:site": "likec4 build --use-hash-history --no-build-webcomponent --title 'dialed.run architecture' docs/diagrams",
    "diagrams:stale": "sh scripts/diagram-stale.sh"
  },
  "dependencies": {
    "@cf-wasm/og": "^0.5.0",
    "@cf-wasm/photon": "^0.4.0",
    "@garmin/fitsdk": "^21.221.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@react-email/body": "^0.3.0",
    "@react-email/button": "^0.2.1",
    "@react-email/container": "^0.0.16",
    "@react-email/head": "^0.0.13",
    "@react-email/hr": "^0.0.12",
    "@react-email/html": "^0.0.12",
    "@react-email/link": "^0.0.13",
    "@react-email/preview": "^0.0.14",
    "@react-email/text": "^0.1.6",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.25",
    "client-zip": "2.5.1",
    "drizzle-orm": "^0.45.4",
    "entities": "^9.0.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-table": "^2.0.1",
    "micromark-extension-gfm-table": "^2.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sax": "^1.6.1",
    "tailwindcss": "^4.1.18",
    "toucan-js": "^4.1.1",
    "ulidx": "^2.4.1",
    "validator": "13.15.35",
    "web-vitals": "6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@eslint/js": "^10.0.1",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/router-cli": "^1.168.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/html-to-text": "^9.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/normalize-package-data": "^2.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sax": "^1.2.7",
    "@types/validator": "13.15.10",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "axe-core": "^4.14.1",
    "canvas": "^3.2.3",
    "dependency-cruiser": "^18.8.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "fallow": "^3.43.2",
    "guardrails-core": "https://github.com/ddteeter/agentic-guardrails-scaffolding/releases/download/v0.16.0/guardrails-core-0.16.0.tgz",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "likec4": "1.61.0",
    "lockfile-lint": "5.1.0",
    "monocart-coverage-reports": "^3.2.1",
    "normalize-package-data": "^9.0.0",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "canvas": true,
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  },
  "license": "AGPL-3.0-only",
  "description": "A virtual wardrobe for runners: log what you wore, on which run, in which weather.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ddteeter/dialed.run.git"
  },
  "engines": {
    "node": "^24.20.0 || >=26",
    "npm": ">=11.19.0"
  },
  "overrides": {
    "vite-plus": {
      "@vitest/browser-playwright": "$@vitest/browser-playwright"
    }
  }
}
