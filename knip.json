{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/router.tsx",
    "src/routes/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle-core.config.ts",
    "drizzle-weather.config.ts",
    "test/**/*.test.{ts,tsx}",
    "test/apply-migrations.ts",
    "src/lib/contracts.ts",
    "src/lib/ids.ts",
    "src/db/schema-core.ts",
    "src/db/schema-auth.ts",
    "src/db/schema-weather.ts",
    "src/env/index.ts",
    "src/ui/icons.tsx",
    "src/ui/motion.ts",
    "playwright.config.ts",
    "e2e/**/*.spec.ts",
    "src/modules/*/index.ts",
    "src/modules/*/functions.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "test/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "@tailwindcss/typography",
    "cloudflare"
  ]
}
