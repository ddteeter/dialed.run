// The hand-written half of the model. What is bound (databases, buckets,
// queues, crons) and the modules with their imports are in
// structure.generated.c4; this file adds the people, the systems we call,
// the entry points inside each module, and the arrows a flow draws.
model {
  runner = actor 'Runner' {
    description 'Logs runs and the kit worn on them'
  }
  operator = actor 'Operator' {
    description 'Works the Desk'
  }
  requester = actor 'Requester' {
    description 'Asks for something on dialed.run to come down; needs no account'
  }


  cf = system 'Cloudflare' {
    description 'One Worker, SSR-first, on the Workers Paid plan'
    icon tech:cloudflare

    app = worker 'TanStack Start Worker' {
      description 'SSR, server functions, API routes, queue consumers and crons'
    }
  }

  // Run import: an uploaded file becomes a run.
  extend cf.app.runs {
    upload = inRequest 'startFileImport / startFileUpload' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'The upload server function and what it calls. Its inner step, startImport, is where a Garmin import also enters'
    }
    consumer = offQueue 'import consumer' {
      technology 'off the queue: seconds later, at least once'
      description 'Parses the file and writes the run'
    }
    deadLetter = offQueue 'import dead-letter consumer' {
      technology 'off the queue: after 3 failed retries'
      description 'Fails an import whose job ran out of retries, and tells its runner'
    }
  }

  // Product enrichment: a pasted product link becomes the product's specs.
  extend cf.app.closet {
    saveGarment = inRequest 'createItemFn / updateItemFn' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'Saves a garment; a product link asks for enrichment'
    }
  }
  extend cf.app.enrichment {
    request = module 'requestEnrichment' {
      description 'Claims the product, then sends EnrichJob'
    }
    consumer = offQueue 'enrichment consumer' {
      technology 'off the queue: up to 30 seconds later, at least once'
      description 'Fetches the page, stores it, extracts the specs'
    }
    deadLetter = offQueue 'enrichment dead-letter consumer' {
      technology 'off the queue: after 3 failed retries'
      description 'Marks the product failed'
    }
  }
  extend cf.app.ops {
    deskRetry = inRequest 'Desk: Retry' {
      technology 'in the request: one attempt, the operator is waiting'
      description 'Re-fetches a product the system gave up on'
    }
  }

  // Feed reads: the Following feed and the conditions consensus.
  extend cf.app.feed {
    followingQuery = inRequest 'followingFeedQuery' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'Reads one page of the Following feed'
    }
    conditionsQuery = inRequest 'yourConditionsQuery' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'Reads what other runners wore in the conditions at a place'
    }
    // A public kit's photos: a verdict on a PUBLIC kit copies its photos out.
    verdict = inRequest 'submitVerdictAction' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'Logs a run\'s verdict, its kit\'s audience, tags and flags'
    }
  }
  extend cf.app.ops.publicWeb {
    purge = module 'purgePublicPages' {
      description 'What every writer that changes a public page calls: purges its tags from the edge, and asks for its photos to be synced'
    }
    sync = module 'syncPublicPhotos' {
      description 'Makes the public photo bucket match the rule: runs after the response, kept alive by waitUntil, and hourly over everything'
    }
  }

  // The data export: a runner's rows and files, zipped and emailed.
  extend cf.app.account {
    request = inRequest 'requestExportFn' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'Get a copy: makes the export row and sends its job'
    }
  }
  extend cf.app.account.data {
    download = inRequest 'GET /account/export/{token}' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'The email\'s download link: the ZIP, for its owner, until it expires'
    }
  }
  extend cf.app.account.exportBuild {
    consumer = offQueue 'export consumer' {
      technology 'off the queue: seconds later, at least once'
      description 'Builds the ZIP, marks the export ready and owes its email'
    }
    deadLetter = offQueue 'export dead-letter consumer' {
      technology 'off the queue: after 3 failed retries'
      description 'Marks an export failed whose job ran out of retries'
    }
  }

  // Account deletion: a week to keep it, then the purge.
  extend cf.app.account {
    deletionRequest = inRequest 'requestDeletionFn' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'Delete my account: writes the claim, signs the runner out, owes the email'
    }
    keep = inRequest 'keepAccountFn' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'Keep my account: deletes the claim while the purge has not started'
    }
  }

  // Photo screening: a photo is classified before strangers see it.
  extend cf.app.feed {
    photoUpload = inRequest 'uploadPhotoAction' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'Adds a photo to a kit: stores it, writes it pending, screens it inline'
    }
  }

  // The outbox: a debt to another system, written with its change.
  extend cf.app.closet {
    removePhoto = inRequest 'removePhotoFn' {
      technology 'in the request: one attempt, the runner is waiting'
      description 'Removes a garment\'s photo: clears the row and owes the bytes\' delete'
    }
  }

  // Removal requests and copyright holds.
  extend cf.app.safety {
    takedownRequest = inRequest 'takedownRequestFn' {
      technology 'in the request: one attempt, the requester is waiting'
      description 'The removal request form: files the request and hides its subject'
    }
    confirmRequest = inRequest 'confirmTakedownFn' {
      technology 'in the request: one attempt, the requester is waiting'
      description 'The receipt\'s confirm link, for a requester who must confirm first'
    }
    counterNotice = inRequest 'counterNoticeAction' {
      technology 'in the request: one attempt, the operator is waiting'
      description 'Desk: records a copyright counter-notice and sets the restore day'
    }
  }
  extend cf.app.feed {
    decideRemoval = inRequest 'decideRemovalRequestAction' {
      technology 'in the request: one attempt, the operator is waiting'
      description 'Desk: Take it down or Decline a removal request'
    }
    copyrightTakedown = inRequest 'takedownAction' {
      technology 'in the request: one attempt, the operator is waiting'
      description 'Desk: takes content down on a copyright notice and opens its hold'
    }
  }

  // The systems we call and do not run.
  provider = external 'Visual Crossing' {
    description 'Weather provider, behind an adapter'
  }
  shop = external 'Brand product pages' {
    description 'The product page a runner linked'
  }
  firecrawl = external 'Firecrawl' {
    description 'Fetching proxy, when a shop refuses a Worker'
  }
  openai = external 'OpenAI' {
    description 'Product extraction and photo screening'
  }
  sentry = external 'Sentry' {
    description 'Exceptions, digest events and cron check-ins'
  }
  turnstile = external 'Cloudflare Turnstile' {
    description 'The bot check, verified server-side'
  }
  strava = external 'Strava' {
    description 'A runner\'s connection, and a webhook that is a reminder only'
  }
  google = external 'Google' {
    description 'Sign-in'
  }
  garmin = external 'Garmin Connect' {
    description 'Owner only: lists runs and fetches one .FIT'
  }
  marketing = external 'Marketing site' {
    description 'dialed.run, with the request-access form'
  }

  runner -> cf.app 'uses the app: SSR pages and server functions'
  operator -> cf.app.ops 'works the Desk'
  marketing -> cf.app.account 'posts a request for access'
  strava -> cf.app.runs 'sends an activity event: a reminder only'
  cf.app.runs -> strava 'connects and revokes; reads no activity'
  cf.app.runs -> garmin 'lists runs, fetches one .FIT'
  cf.app.auth -> google 'OAuth'
  cf.app.ops -> sentry 'reports exceptions, checks in each cron'
  cf.app.ops -> turnstile 'verifies the bot check'
  cf.app.ops -> cf.vitalsDataset 'writes the speed beacon, reads the daily rollup'
  cf.app.ops -> cf.opsDb 'writes the daily speed rollup'
  cf.app.ops -> cf.mediaBackupBucket 'copies new and changed photos daily'
  cf.app.safety.screening -> openai 'screens photos'
  cf.app.email -> cf.emailSending 'sends every message'

  runner -> cf.app.runs.upload 'uploads a run file'
  cf.app.runs.upload -> cf.importsBucket 'stores the raw file'
  cf.app.runs.upload -> cf.coreDb 'inserts the import row'
  cf.app.runs.upload -[async]-> cf.importsQueue 'enqueues ImportJob'
  cf.importsQueue -[async]-> cf.app.runs.consumer 'delivers ImportJob'
  cf.app.runs.consumer -> cf.importsBucket 'reads the raw file'
  cf.app.runs.consumer -> cf.coreDb 'claims the import, writes the run'
  cf.app.runs.consumer -> cf.app.weather 'asks for the conditions'
  cf.importsDlq -[async]-> cf.app.runs.deadLetter 'delivers the dead job'
  cf.app.runs.deadLetter -[recovery]-> cf.coreDb 'marks the import failed'
  cf.app.cronDaily1200 -[recovery]-> cf.coreDb 'finds imports pending past 15 minutes'
  cf.app.cronDaily1200 -[recovery]-> cf.importsQueue 'enqueues them again'
  cf.app.cronDaily1200 -> cf.importsBucket 'deletes run files that were read, or failed 30 days ago'
  cf.app.cronHourly00 -[recovery]-> cf.app.weather 'retries runs still pending'
  cf.app.weather -> provider 'finished hours only'
  cf.app.weather -> cf.weatherDb 'caches the observation'
  cf.app.weather -> cf.coreDb 'weather_status and run_conditions'

  runner -> cf.app.closet.saveGarment 'saves a garment with a product link'
  cf.app.closet.saveGarment -> cf.coreDb 'finds or makes the shared product'
  cf.app.closet.saveGarment -> cf.app.enrichment.request 'asks for enrichment'
  cf.app.enrichment.request -> cf.coreDb 'claims the product: pending'
  cf.app.enrichment.request -[async]-> cf.enrichmentQueue 'sends EnrichJob'
  cf.enrichmentQueue -[async]-> cf.app.enrichment.consumer 'delivers EnrichJob'
  cf.app.enrichment.consumer -> shop 'fetches the page'
  cf.app.enrichment.consumer -> firecrawl 'fetches a refused page'
  cf.app.enrichment.consumer -> cf.mediaBucket 'stores and reuses the page'
  cf.app.enrichment.consumer -> openai 'asks for the composition'
  cf.app.enrichment.consumer -> cf.coreDb 'writes the specs: done'
  cf.enrichmentDlq -[async]-> cf.app.enrichment.deadLetter 'delivers the dead job'
  cf.app.enrichment.deadLetter -[recovery]-> cf.coreDb 'marks the product failed'
  cf.app.cronHourly30 -[recovery]-> cf.coreDb 'finds pending, re-claims failed'
  cf.app.cronHourly30 -[recovery]-> cf.enrichmentQueue 'sends them again'
  operator -> cf.app.ops.deskRetry 'presses Retry on a given-up product'
  cf.app.ops.deskRetry -[recovery]-> cf.app.enrichment.request 'asks for enrichment again'

  runner -> cf.app.feed.followingQuery 'opens the Following feed'
  cf.app.feed.followingQuery -> cf.app.feed.following 'asks for a page'
  cf.app.feed.following -> cf.coreDb 'reads the page and what it shows'
  cf.app.feed.following -> cf.app.weather 'reads each run\'s observation'

  runner -> cf.app.feed.conditionsQuery 'opens Conditions at a place'
  cf.app.feed.conditionsQuery -> cf.app.feed.consensus 'asks for the consensus'
  cf.app.feed.consensus -> cf.app.feed.conditions 'asks for the conditions now'
  cf.app.feed.conditions -> cf.app.weather 'reads the newest cached observation'
  cf.app.feed.consensus -> cf.coreDb 'reads matching entries and what was worn'

  runner -> cf.app.feed.verdict 'logs a verdict'
  cf.app.feed.verdict -> cf.coreDb 'writes the verdict and audience'
  cf.app.feed.verdict -> cf.app.ops.publicWeb.purge 'purges a public kit\'s pages'
  cf.app.ops.publicWeb.purge -[async]-> cf.app.ops.publicWeb.sync 'syncs its photos after the response'
  cf.app.ops.publicWeb.sync -> cf.coreDb 'claims, marks and deletes copies'
  cf.app.ops.publicWeb.sync -> cf.mediaBucket 'reads the private photo'
  cf.app.ops.publicWeb.sync -> cf.publicPhotosBucket 'puts and deletes the copies'
  cf.app.cronHourly15 -[recovery]-> cf.app.ops.publicWeb.sync 'reconciles every kit, and deletes unnamed objects'
  cf.app.ops.publicWeb.sync -> sentry 'reports a failed copy or delete'

  runner -> cf.app.account.request 'asks for a copy of their data'
  cf.app.account.request -> cf.coreDb 'inserts the export row'
  cf.app.account.request -[async]-> cf.exportsQueue 'sends account_export'
  cf.exportsQueue -[async]-> cf.app.account.exportBuild.consumer 'delivers account_export'
  cf.app.account.exportBuild.consumer -> cf.coreDb 'claims the export, marks it ready'
  cf.app.account.exportBuild.consumer -> cf.app.weather 'reads each run\'s conditions'
  cf.app.account.exportBuild.consumer -> cf.mediaBucket 'lists and reads the photos'
  cf.app.account.exportBuild.consumer -> cf.importsBucket 'reads the run files, writes the ZIP'
  cf.app.account.exportBuild.consumer -> cf.app.ops.owedEmail 'sends the email now'
  cf.exportsDlq -[async]-> cf.app.account.exportBuild.deadLetter 'delivers the dead job'
  cf.app.account.exportBuild.deadLetter -[recovery]-> cf.coreDb 'marks the export failed'
  cf.app.cronHourly00 -[recovery]-> cf.exportsQueue 're-sends stalled exports'
  cf.app.cronHourly00 -> cf.importsBucket 'deletes expired export ZIPs'
  runner -> cf.app.account.data.download 'downloads the export'
  cf.app.account.data.download -> cf.importsBucket 'reads the ZIP'

  runner -> cf.app.account.deletionRequest 'asks to delete the account'
  cf.app.account.deletionRequest -> cf.coreDb 'writes the claim, signs out, owes the email'
  cf.app.account.deletionRequest -[async]-> cf.app.ops.owedEmail 'sends "delete scheduled"'
  cf.app.account.deletionRequest -> cf.app.ops.publicWeb.purge 'purges the runner\'s public pages'
  cf.app.account.deletionRequest -> cf.app.runs 'disconnects Strava'
  runner -> cf.app.account.keep 'keeps the account'
  cf.app.account.keep -> cf.coreDb 'deletes the claim before the purge starts'
  cf.app.cronDaily1200 -> cf.app.account.purge 'purges the accounts past their week'
  cf.app.cronDaily1200 -[recovery]-> cf.app.account.purge 'takes a failed purge again'
  cf.app.account.purge -> cf.coreDb 'claims, then deletes the account\'s rows'
  cf.app.account.purge -> cf.app.weather 'forgets the runner\'s own bands'
  cf.app.account.purge -> cf.app.runs 'disconnects Strava'
  cf.app.account.purge -> cf.app.feed 'deletes every run and entry'
  cf.app.account.purge -> cf.importsBucket 'deletes the run files and export ZIPs'
  cf.app.account.purge -> sentry 'reports a failed purge'
  cf.app.cronDaily1200 -[recovery]-> cf.app.ops.outbox 'drains the owed deletes and email'

  runner -> cf.app.feed.photoUpload 'adds a photo to a kit'
  cf.app.feed.photoUpload -> cf.mediaBucket 'stores the photo'
  cf.app.feed.photoUpload -> cf.coreDb 'writes the photo row: pending'
  cf.app.feed.photoUpload -> cf.app.safety.screening 'screens it inline'
  cf.app.feed.photoUpload -[async]-> cf.app.ops.publicWeb.sync 'copies a passed photo on a PUBLIC kit'
  cf.app.safety.screening -> cf.coreDb 'writes the verdict, the visibility and any review'
  cf.app.cronHourly15 -[recovery]-> cf.app.safety.screening 'screens what is still pending'
  cf.app.cronHourly15 -[recovery]-> cf.coreDb 'reads pending photos, opens Review rows for stuck ones'
  cf.app.cronHourly15 -> cf.mediaBucket 'fetches each pending photo'
  cf.app.cronHourly15 -> sentry 'names photos still pending'

  runner -> cf.app.closet.removePhoto 'removes a garment\'s photo'
  cf.app.closet.removePhoto -> cf.coreDb 'clears the photo and owes its delete'
  cf.app.closet.removePhoto -> cf.app.ops.outbox 'pays the debt now: the fast path'
  cf.app.ops.outbox -> cf.mediaBucket 'deletes owed photo objects'
  cf.app.ops.outbox -> cf.coreDb 'claims and deletes outbox rows'
  cf.app.ops.outbox -> cf.app.ops.owedEmail 'sends an owed email'
  cf.app.cronHourly00 -[recovery]-> cf.app.ops.outbox 'drains owed email and product links'
  cf.app.cronDaily1200 -[recovery]-> cf.coreDb 'claims due outbox rows'
  cf.app.cronDaily1200 -> sentry 'names the outbox backlog in the digest'

  requester -> cf.app.safety.takedownRequest 'asks for something to come down'
  cf.app.safety.takedownRequest -> cf.coreDb 'files the request and hides its subject'
  cf.app.safety.takedownRequest -[async]-> cf.app.ops.publicWeb.purge 'purges the hidden subject\'s pages'
  requester -> cf.app.safety.confirmRequest 'confirms the request'
  cf.app.safety.confirmRequest -> cf.coreDb 'claims the confirmation and hides'
  cf.app.cronHourly00 -[recovery]-> cf.app.ops.owedEmail 'sends owed alerts, receipts and answers'
  cf.app.cronHourly00 -> cf.coreDb 'owes the Desk its removal reminders'
  cf.app.ops.owedEmail -> operator 'emails the Desk its alerts'
  operator -> cf.app.feed.decideRemoval 'decides a removal request'
  cf.app.feed.decideRemoval -> cf.coreDb 'takes down or gives back, and claims the request'
  cf.app.feed.decideRemoval -> cf.app.ops.outbox 'deletes the photos now'
  cf.app.feed.decideRemoval -[async]-> cf.app.ops.publicWeb.purge 'purges the subject\'s pages'
  operator -> cf.app.feed.copyrightTakedown 'takes content down on a copyright notice'
  cf.app.feed.copyrightTakedown -> cf.coreDb 'opens the hold and hides the subject'
  cf.app.feed.copyrightTakedown -[async]-> cf.app.ops.publicWeb.purge 'purges the subject\'s pages'
  operator -> cf.app.safety.counterNotice 'records a counter-notice'
  cf.app.safety.counterNotice -> cf.coreDb 'sets the restore day'
  cf.app.cronDaily1200 -> cf.coreDb 'restores, purges and forgets holds and requests'
  cf.app.cronDaily1200 -> cf.mediaBucket 'deletes a purged hold\'s bytes'
  cf.app.ops.publicWeb.purge -> sentry 'reports a failed purge'
  cf.app.cronDaily1200 -> sentry 'closes the check-in as an error when a sweep throws'
}
