views {
  // What a new element joins is a choice: each view names what it includes.
  view index {
    title 'dialed.run: system context'
    include *
  }

  view platform of cf {
    title 'Inside Cloudflare'
    include cf.*
  }

  view modules of cf.app {
    title 'The modules and what each imports'
    include cf.app.* where kind is module
    exclude * -> * where kind is not imports
  }
}
