// Generated by `npm run diagrams:generate`. Do not edit:
// `npm run diagrams:check` regenerates this file and compares. It is
// built from wrangler.jsonc, src/modules/ops/desk/crons.ts and the imports
// under src/modules, with the descriptions in structure.words.json.
model {
  extend cf {
    coreDb = database 'D1: dialed-core' {
      description 'Users, closet, runs, products, feed'
    }
    weatherDb = database 'D1: dialed-weather' {
      description 'The shared observation cache, and the bands runners set by hand'
    }
    opsDb = database 'D1: dialed-ops' {
      description 'Data about the app, never about anyone: the daily speed rollup'
    }
    vitalsDataset = database 'Analytics Engine: dialed_vitals' {
      description 'The speed beacon\'s readings'
    }
    mediaBucket = bucket 'R2: dialed-media' {
      description 'Garment and kit photos, and product page snapshots'
    }
    importsBucket = bucket 'R2: dialed-imports' {
      description 'Uploaded run files, and data exports'
    }
    publicPhotosBucket = bucket 'R2: dialed-public-photos' {
      description 'Copies of screened photos on public kits'
    }
    mediaBackupBucket = bucket 'R2: dialed-media-backup' {
      description 'The daily copy of garment and kit photos'
    }
    enrichmentQueue = queue 'Queue: dialed-enrichment' {
      description 'EnrichJob: a product id, not the work'
    }
    enrichmentDlq = queue 'Queue: dialed-enrichment-dlq' {
      description 'Enrichment jobs that failed every retry'
    }
    exportsQueue = queue 'Queue: dialed-exports' {
      description 'One data export a delivery'
    }
    exportsDlq = queue 'Queue: dialed-exports-dlq' {
      description 'Exports that failed every retry'
    }
    importsQueue = queue 'Queue: dialed-imports' {
      description 'ImportJob, and Strava\'s reminder, revoke and deauthorize jobs'
    }
    importsDlq = queue 'Queue: dialed-imports-dlq' {
      description 'Import jobs that failed every retry'
    }
    emailSending = external 'Email sending: EMAIL' {
      description 'Cloudflare\'s email sending: every message the app sends leaves through it'
    }
  }
  extend cf.app {
    account = module 'account' {
      access = module 'account/access'
      data = module 'account/data'
      exportBuild = module 'account/export-build'
      handles = module 'account/handles'
      purge = module 'account/purge'
      terms = module 'account/terms'
      verification = module 'account/verification'
    }
    auth = module 'auth' {
      expiredRows = module 'auth/expired-rows'
    }
    closet = module 'closet'
    dispatch = module 'dispatch'
    email = module 'email'
    enrichment = module 'enrichment'
    feed = module 'feed' {
      attach = module 'feed/attach'
      conditions = module 'feed/conditions'
      consensus = module 'feed/consensus'
      entries = module 'feed/entries'
      following = module 'feed/following'
      moderation = module 'feed/moderation'
      publicWeb = module 'feed/public-web'
    }
    notifications = module 'notifications'
    onboarding = module 'onboarding'
    ops = module 'ops' {
      daily = module 'ops/daily'
      desk = module 'ops/desk'
      edge = module 'ops/edge'
      outbox = module 'ops/outbox'
      publicWeb = module 'ops/public-web'
      sentry = module 'ops/sentry'
      speed = module 'ops/speed'
    }
    products = module 'products'
    runs = module 'runs' {
      garmin = module 'runs/garmin'
      imports = module 'runs/imports'
      parsers = module 'runs/parsers'
      strava = module 'runs/strava'
    }
    safety = module 'safety' {
      blur = module 'safety/blur'
      limits = module 'safety/limits'
      notices = module 'safety/notices'
      reports = module 'safety/reports'
      review = module 'safety/review'
      rules = module 'safety/rules'
      runners = module 'safety/runners'
      screening = module 'safety/screening'
      takedowns = module 'safety/takedowns'
    }
    weather = module 'weather' {
      description 'Attaches observed conditions to a run'
      provider = module 'weather/provider'
    }
    cronDaily1200 = onCron 'Cron: daily at 12:00 UTC' {
      technology '0 12 * * * (daily-digest)'
      description 'The daily digest: re-drives what is still owed and reports what is wrong'
    }
    cronHourly00 = onCron 'Cron: every hour at :00' {
      technology '0 * * * * (weather-retry)'
      description 'Retries weather for runs still waiting on conditions, with other hourly upkeep'
    }
    cronHourly15 = onCron 'Cron: every hour at :15' {
      technology '15 * * * * (screening-retry)'
      description 'Retries photo screenings still pending, with other hourly upkeep'
    }
    cronHourly30 = onCron 'Cron: every hour at :30' {
      technology '30 * * * * (enrichment-retry)'
      description 'Re-drives product enrichment still owed, with other hourly upkeep'
    }
  }

  cf.importsQueue -[recovery]-> cf.importsDlq 'dead-letters after 3 retries'
  cf.enrichmentQueue -[recovery]-> cf.enrichmentDlq 'dead-letters after 3 retries'
  cf.exportsQueue -[recovery]-> cf.exportsDlq 'dead-letters after 3 retries'
