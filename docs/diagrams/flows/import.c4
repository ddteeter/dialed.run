views {
  dynamic view importStory {
    title 'A run file becomes a run'

    include
      cf.coreDb with {
        description 'The imports row is the durable marker'
      }

    // source: src/modules/runs/imports.ts startImport (the idempotencyKey lookup)
    runner -> cf.app.runs.upload 'uploads a .FIT file, with an idempotency key' {
      notes '''
        **Guard: the idempotency key.** The form mints a key when it mounts and resends it on every retry.

        A repeat (double click, replayed POST, flaky connection) finds the first import by that key and returns it. Nothing is uploaded or parsed twice.
      '''
    }
    // source: src/modules/runs/imports.ts startImport (importBucket.put, and the delete on a failed insert)
    cf.app.runs.upload -> cf.importsBucket 'stores the raw file' {
      notes '''
        **Not atomic with the next step.** R2 and D1 are two systems.

        **If the insert then fails:** the upload takes its object back, one attempt, and the runner sees the error.
      '''
    }
    // source: src/modules/runs/imports.ts startImport
    cf.app.runs.upload -> cf.coreDb 'inserts the import row: pending' {
      notes '''
        **This row is the recovery marker.** From here on, `pending` means the work is still owed, whatever happens to the request, the queue or the Worker.
      '''
    }
    // source: src/modules/runs/imports.ts startImport (queue.send); src/modules/ops/scheduled.ts redispatchStalledImports
    cf.app.runs.upload -[async]-> cf.importsQueue 'enqueues ImportJob' {
      notes '''
        **Not atomic with the row.** The send can fail, or the Worker can die first.

        **If it is lost:** the row stays `pending`, and the daily digest re-enqueues any import pending for more than 15 minutes. A lost send costs a delay, never the upload.
      '''
      navigateTo importRecovery
    }
    // source: src/modules/runs/imports.ts startImport; src/modules/runs/import-polling.ts importPollIntervalMs
    runner <- cf.app.runs.upload 'answers with the import id' {
      notes '''
        **Timing boundary: the request ends here.** One attempt, no retries inside it.

        The upload screen polls the import\'s status from now on.
      '''
    }
    // source: src/modules/ops/queues.ts handleQueueBatch; wrangler.jsonc queues.consumers, max_retries
    cf.importsQueue -[async]-> cf.app.runs.consumer 'delivers ImportJob' {
      notes '''
        **Timing boundary: seconds later, in a queue consumer.**

        **At least once.** The same job can arrive twice. A failed attempt is retried up to 3 times, then dead-lettered.
      '''
      navigateTo importRecovery
    }
    // source: src/modules/runs/consumer.ts processImportJob, didClaimImport
    cf.app.runs.consumer -> cf.coreDb 'claims the row: pending to processing' {
      notes '''
        **Guard: claim, then work.** The claim is an `UPDATE ... WHERE status IN (\'pending\', \'processing\')`.

        A redelivery of an import that is already `done`, `failed` or `duplicate` claims nothing and stops here.
      '''
    }
    // source: src/modules/runs/consumer.ts processImportJob, failImport
    cf.app.runs.consumer -> cf.importsBucket 'reads the file back and parses it' {
      notes '''
        **If the file cannot be parsed:** the import is marked `failed` with a reason the runner sees. A terminal failure is never silent.
      '''
    }
    // source: src/modules/runs/consumer.ts processImportJob, findDuplicateRun
    cf.app.runs.consumer -> cf.coreDb 'inserts the run, marks the import done' {
      notes '''
        **Guard: the duplicate check.** A run by this runner with the same start time is already in the log? The import becomes `duplicate` and points at that run.
      '''
    }
    // source: src/modules/runs/consumer.ts processImportJob (the injected weather attach)
    cf.app.runs.consumer -> cf.app.weather 'asks for the conditions' {
      notes '''
        **Degrade, don\'t fail.** One attempt. The import is already `done`.

        **If it fails:** the run stays `pending` on its weather and the hourly cron picks it up.
      '''
      navigateTo weatherStory
    }
  }

  dynamic view importRecovery {
    title 'When a step is lost'

    include
      cf.coreDb with {
        description 'The imports row is the durable marker'
      }

    try {
      // source: src/modules/runs/imports.ts startImport (queue.send); src/modules/ops/scheduled.ts redispatchStalledImports
      cf.app.runs.upload -[async]-> cf.importsQueue 'enqueues ImportJob'
    }
    catch 'the send fails, or the Worker dies first' {
      // source: src/modules/ops/scheduled.ts redispatchStalledImports, IMPORT_STALL_GRACE_S
      cf.app.cronDaily1200 -[recovery]-> cf.coreDb 'finds imports pending for 15+ minutes' {
        notes 'Fifteen minutes of grace, so the sweep never races a dispatch still in flight.'
      }
      // source: src/modules/ops/scheduled.ts redispatchStalledImports
      cf.app.cronDaily1200 -[recovery]-> cf.importsQueue 'enqueues them again' {
        notes 'Safe to repeat: the consumer claims the row before it works, so a second copy of the job loses the race and stops.'
      }
    }
    loop 'at least once: up to 3 retries' {
      // source: src/modules/ops/queues.ts handleQueueBatch; wrangler.jsonc queues.consumers, max_retries
      cf.importsQueue -[async]-> cf.app.runs.consumer 'delivers ImportJob'
      // source: src/modules/runs/consumer.ts processImportJob, didClaimImport
      cf.app.runs.consumer -> cf.coreDb 'claims the row, or stops'
    }
    opt 'every retry failed' {
      // source: wrangler.jsonc queues.consumers, max_retries, dead_letter_queue (max_retries 3)
      cf.importsQueue -[recovery]-> cf.importsDlq 'dead-letters the job'
      // source: src/modules/ops/queues.ts handleQueueBatch (dialed-imports-dlq)
      cf.importsDlq -[async]-> cf.app.runs.deadLetter 'delivers it'
      // source: src/modules/runs/consumer.ts handleImportsDlqBatch
      cf.app.runs.deadLetter -[recovery]-> cf.coreDb 'marks the import failed, notifies the runner' {
        notes 'No import ends in silence: the runner is told, and the job lands where an operator can retry it.'
      }
    }
  }

  dynamic view weatherStory {
    title 'The run gets its conditions'

    // source: src/modules/weather/attach.ts attachObservation
    cf.app.runs.consumer -> cf.app.weather 'attachObservation(runId)'
    // source: src/modules/weather/attach.ts resolveAndAttach, settlesAt, SETTLE_MARGIN_SECONDS
    cf.app.weather -> provider 'asks for the finished hours' {
      notes '''
        **Timing boundary: an hour is asked for once, two hours after it ends.** The cache is shared and never refreshed, so only settled hours are fetched.
      '''
    }
    parallel {
      // source: src/modules/weather/attach.ts sampleRunHours, upsertRealObservation
      cf.app.weather -> cf.weatherDb 'caches the observation'
      // source: src/modules/weather/attach.ts setStatus; src/modules/weather/run-conditions-copy.ts weatherHalfStatements
      cf.app.weather -> cf.coreDb 'writes weather_status and run_conditions'
    }
    opt 'some hours had not settled, or the provider failed' {
      // source: src/modules/ops/scheduled.ts retryPendingWeather (the weather-retry job); src/modules/weather/attach.ts retryPendingWeather, FAIL_AFTER_SECONDS (the give-up)
      cf.app.cronHourly00 -[recovery]-> cf.app.weather 'retries the runs still pending' {
        notes '''
          **The marker is `runs.weather_status = pending`.** The hourly cron re-drives it.

          **It gives up** five hours after the run\'s last hour settles, and says so on the run.
        '''
      }
      // source: src/modules/weather/attach.ts retryPendingWeather, resolveAndAttach
      cf.app.weather -> provider 'asks for the hours settled since'
      // source: src/modules/weather/attach.ts resolveAndAttach, setStatus
      cf.app.weather -> cf.coreDb 'the run is settled'
    }
  }
}
