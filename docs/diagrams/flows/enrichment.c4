views {
  dynamic view enrichmentStory {
    title 'A product link becomes the product\'s specs'

    include
      runner with {
        description 'Saves a garment with a product link'
      }
    include
      cf.coreDb with {
        description 'The products row is the durable marker'
      }

    // source: src/modules/closet/functions.ts createItemFn, updateItemFn, withResolvedProduct (then createItem with data.idempotencyKey); src/modules/closet/service.ts withResolvedProduct, isListedName, isUnconfirmed, assertLinkAllowed, productLinkFor (isDeniedLink); src/modules/closet/product-link.ts linkTypedGarments, productLinkFor
    runner -> cf.app.closet.saveGarment 'saves a garment with a brand, a model and a product link' {
      notes '''
        **Guard: the garment\'s idempotency key, on a create.** A repeat of the save also asks for enrichment again, which the claim below turns into nothing.

        **Guard: only a nameable product.** An empty or listed brand or model, or an unconfirmed runner, makes no product and asks for nothing; the garment saves as typed. Confirming the account later links those garments the same way, and that asks for enrichment too.

        **Guard: the denylist, before the product.** A link the denylist refuses fails the save before the shared product is found or made, so it never becomes a product\'s link and asks for nothing. Wherever a garment is linked, confirming included, a denied link is left out and the product is linked without it.
      '''
    }
    // source: src/modules/products/service.ts resolveProduct, createOrGetProduct (onConflictDoUpdate, coalesce on source_url)
    cf.app.closet.saveGarment -> cf.coreDb 'finds or makes the shared product, keeps its link' {
      notes '''
        **Guard: create-if-missing on the normalized brand and name.** Products are shared rows. The first link a product gets stays its link; a later paste does not replace it.
      '''
    }
    // source: src/modules/closet/service.ts productLinkFor; src/modules/enrichment/enqueue.ts enqueueEnrichment, isClaimable; src/modules/enrichment/spend-limit.ts canSpendRunnerRequest, ENRICHMENT_REQUESTS_PER_RUNNER_PER_DAY (50)
    cf.app.closet.saveGarment -> cf.app.enrichment.request 'asks for enrichment' {
      notes '''
        **Bounded.** Only a product that could be claimed is counted, against the runner\'s 50 requests a day. Over that, nothing is asked and the garment saves unenriched.

        **Degrade, don\'t fail.** This never throws. A failed claim or a failed send is reported and swallowed, and the garment still saves. After a failed claim the product stays as it was: nothing re-drives it, and the next save that links it asks again.

        It runs before the garment row is written.
      '''
    }
    // source: src/modules/enrichment/request.ts requestEnrichment, abandonedBefore (didClaim from none, or failed past the first day, source_url not null)
    cf.app.enrichment.request -> cf.coreDb 'claims the product: none or failed to pending' {
      notes '''
        **Guard: the claim.** `none` flips to `pending`; `failed` only once the product\'s first day is over, because inside it the hourly sweep owns the retry. Only with a link. A second paste while a job is in flight, or of a product already `done`, claims nothing and sends nothing.

        **This column is the recovery marker.** `pending` means the product still owes an extraction.
      '''
    }
    // source: src/modules/enrichment/request.ts requestEnrichment (queue.send); src/modules/dispatch/scheduled.ts redispatchStalledEnrichments, ENRICHMENT_STALL_GRACE_S (15 minutes); src/modules/ops/desk/crons.ts cronRegistry (30 * * * *)
    cf.app.enrichment.request -[async]-> cf.enrichmentQueue 'sends EnrichJob: the product id' {
      notes '''
        **Not atomic with the claim.** D1 and a queue are two systems.

        **If it is lost:** the product stays `pending`, and the hourly enrichment-retry cron sends it again once it is 15 minutes old. A lost send costs up to about an hour and a quarter (15 minutes\' grace, then the next :30), never the save.
      '''
      navigateTo enrichmentRecovery
    }
    // source: src/modules/closet/functions.ts createItemFn (createItem after withResolvedProduct); src/modules/closet/service.ts createItem, updateItem, assertLinkAllowed
    runner <- cf.app.closet.saveGarment 'saves the garment and answers' {
      notes '''
        **Timing boundary: the request ends here.** The runner waits for the save, never for the page.

        **If the link is denied:** the save is refused with a field error, after enrichment was asked for. The product is shared, so a later save that links it allowed is not wasted.
      '''
    }
    // source: src/modules/dispatch/queues.ts handleQueueBatch (dialed-enrichment); src/lib/sql/queue-batch.ts consumeEach; wrangler.jsonc queues.consumers, max_batch_size, max_retries (1 and 3)
    cf.enrichmentQueue -[async]-> cf.app.enrichment.consumer 'delivers EnrichJob' {
      notes '''
        **Timing boundary: seconds later, in a queue consumer.** A batch is one job, so the queue does not wait to fill one, and a job that ends its invocation takes no other job with it.

        **At least once.** The same job can arrive twice, and the sweep can send a second copy. A thrown error retries the message, up to 3 times, then it is dead-lettered.
      '''
      navigateTo enrichmentRecovery
    }
    // source: src/modules/enrichment/consume.ts processEnrichJob (extractionStatus !== "pending")
    cf.app.enrichment.consumer -> cf.coreDb 'reads the product: only pending is work' {
      notes '''
        **Guard: the status.** A job for a product that is `done` (a redelivery after success) or `none` (sent without the claim) is acked and ignored.
      '''
    }
    // source: src/modules/enrichment/consume.ts extractPending, fetchAndExtract, canSpendPageFetch, markFailed; src/modules/enrichment/spend-limit.ts PAGE_FETCHES_PER_HOUR (200)
    cf.app.enrichment.consumer -> shop 'fetches, stores and reads the page' {
      notes '''
        **Guard: the stored page.** A page this product stored in the last hour is read again rather than fetched again, so a redelivery never pays for a second fetch.

        **Bounded.** A fresh fetch spends one of 200 page fetches an hour, shared by everyone. Over that, the job is acked and the product stays `pending` for the sweep.

        **If the page refuses** (a 404, a private host, too large, a 403 with no proxy): the product is marked `failed`, the job is acked, and the queue does not retry it. Inside the product\'s first day the failure is parked with one try counted, for the sweep; past it, it goes on the Desk\'s Gave up in the same batch.
      '''
      navigateTo enrichmentExtraction
    }
    // source: src/modules/enrichment/consume.ts extractFrom; src/modules/products/apply-extraction.ts applyExtraction, ExtractionConflictError (the ledger guard)
    cf.app.enrichment.consumer -> cf.coreDb 'writes the specs back: pending to done' {
      notes '''
        **Guard: the ledger.** The update only lands if the product\'s extraction ledger is the one this job read. A job that lost the race throws, and its retry starts from the stored page.

        **What a runner entered is the floor.** Enrichment fills a field only where nobody else has written it.
      '''
    }
  }

  dynamic view enrichmentExtraction {
    title 'The page is fetched, kept and read'

    include
      cf.coreDb with {
        description 'The products row is the durable marker'
      }

    // source: src/modules/enrichment/consume.ts beforeStored, fetchAndStore; src/modules/enrichment/fetch-page.ts fetchProductPage, TIMEOUT_MS, MAX_REDIRECTS, assertFetchable, assertShortEnough; src/modules/enrichment/meta-refresh.ts refreshTarget; src/modules/enrichment/bounds.ts MAX_BYTES; src/lib/contracts/common.ts MAX_PRODUCT_LINK_LENGTH; src/modules/enrichment/html.ts readPage, MAX_OPEN_TAGS
    cf.app.enrichment.consumer -> shop 'fetches the page, one hop at a time' {
      notes '''
        **Bounded.** 10 seconds a hop, at most 5 redirects (a meta refresh counts as one), at most 6 MB of page. Every hop is checked before it is fetched, and no address, the proxy\'s included, may be longer than 2,048 characters. A page with more than 512 tags open at once is refused.

        **If it fails:** the try is failed (`failed`, acked), whether the page refused or the fetch threw: a network error, a timeout, or an error before the page is stored. The hourly sweep\'s re-drive is the next try, so each try is one counted fetch.
      '''
    }
    opt 'the shop refuses a Worker (401, 403, 429 or 503), a proxy key is set, and neither the product\'s nor the day\'s proxy calls are spent' {
      // source: src/modules/enrichment/fetch-page.ts refused, REFUSALS, fetchProductPage (proxyApiKey); src/modules/enrichment/firecrawl.ts scrapeThroughProxy, PROXY_TIMEOUT_MS; src/modules/enrichment/consume.ts canSpendProxyFor; src/modules/enrichment/spend-limit.ts canSpendProductProxyCall, PROXY_CALLS_PER_PRODUCT_PER_DAY (1), canSpendProxyCall, PROXY_CALLS_PER_DAY (150), forgetProductProxyCall
      cf.app.enrichment.consumer -> firecrawl 'fetches the page through the proxy' {
        notes '''
          **Bounded.** One proxy call a product a day, asked first, so a product\'s later tries that day go direct and spend nothing shared. Then 150 proxy calls a day, shared by everyone, and at most one a page. When the day\'s calls refuse, the product\'s call is given back, so it has it still once the day has room. The proxy call has 30 seconds.

          **Degrade, don\'t fail.** With no key, or past the day\'s calls, a refused page is a failed fetch.
        '''
      }
    }
    // source: src/modules/enrichment/consume.ts fetchAndExtract, isLandingDenied, dropDeniedSource; src/modules/ops/desk/queues.ts enrichmentDeps; src/modules/safety/rules/denylist.ts isDeniedOnLanding
    cf.app.enrichment.consumer -> cf.coreDb 'records where the link landed and checks it against the denylist' {
      notes '''
        **Guard: an upsert on the link.** A landing on another domain is recorded in `link_landings`. A landing with no readable domain counts as denied.

        **If the landing is denied:** nothing from the page is kept. The product lets go of the link and goes back to `none`, so the next runner\'s link can ask again.
      '''
    }
    // source: src/modules/enrichment/snapshot.ts putSnapshot
    cf.app.enrichment.consumer -> cf.mediaBucket 'stores the page before reading it' {
      notes '''
        **Not atomic with the next step.** R2 and D1 are two systems. The page goes first, so a parser that throws can never cost us the page.

        **If the next step fails:** an object with no row is left behind. It is storage, not a wrong answer.
      '''
    }
    // source: src/modules/enrichment/consume.ts fetchAndExtract, recordSnapshot; src/modules/enrichment/snapshot.ts recordSnapshot
    cf.app.enrichment.consumer -> cf.coreDb 'records the snapshot before reading it' {
      notes '''
        **Before the ladder runs.** The row is written with no rung yet, so a read that throws leaves a page the retry finds and reads again instead of fetching it again. The rung that read it is set with the write-back.
      '''
    }
    // source: src/modules/enrichment/model/rung.ts modelPass; src/modules/enrichment/model/chat-completions.ts createChatCompletionsModel, TIMEOUT_MS, MAX_ANSWER_TOKENS, UnreadableAnswerError; src/modules/enrichment/model/from-env.ts extractionModelFromEnv; src/modules/enrichment/consume.ts isModelCallSpent, latestSnapshot, markFailed; src/modules/enrichment/spend-limit.ts canSpendModelCall, MODEL_CALLS_PER_HOUR (200)
    cf.app.enrichment.consumer -> openai 'asks the model for what the page left blank' {
      notes '''
        **Bounded.** 200 model calls an hour, shared by everyone, counted before the ladder reads the stored page, a re-read of one included. Over that, the job is acked and the product stays `pending` for the sweep, with the page kept for it: a stored page no rung has read is read on the next try whatever its age. The Desk\'s re-run is not counted. The answer is capped at 4,000 tokens, and a field the contract refuses is dropped, keeping the rest.

        **If it fails:** an answer that is not an object at all (cut off at the cap, a list, a string) fails the try: one try on the product, acked, with the page kept, and the sweep\'s re-drive is the next try. Any other error throws, the queue retries, and the product stays `pending`, because the model is the only source of composition and a `done` product would never be asked again. The call has 30 seconds.

        With no model key, this step is skipped and the declared fields are the answer.
      '''
    }
    // source: src/modules/enrichment/consume.ts fetchAndExtract, runLadder, extractFrom (the rung update); src/modules/products/apply-extraction.ts applyExtraction
    cf.app.enrichment.consumer -> cf.coreDb 'writes the rung and the specs back: pending to done'
    // source: src/modules/enrichment/consume.ts processEnrichJob, gaveUpClear (the batch after the write-back)
    cf.app.enrichment.consumer -> cf.coreDb 'clears any give-up left from earlier tries' {
      notes '''
        **Not atomic with the write-back.** A clear that fails throws, and the redelivery finds the product `done` and stops.
      '''
    }
  }

  dynamic view enrichmentRecovery {
    title 'When an enrichment step is lost'

    include
      cf.coreDb with {
        description 'The products row is the durable marker'
      }

    try {
      // source: src/modules/enrichment/request.ts requestEnrichment (queue.send)
      cf.app.enrichment.request -[async]-> cf.enrichmentQueue 'sends EnrichJob'
    }
    catch 'the send fails, or the Worker dies first' {
      // source: src/modules/dispatch/scheduled.ts redispatchStalledEnrichments, stalledPending, ENRICHMENT_STALL_GRACE_S, runHourly, hourlyReport (limit 100); src/modules/ops/desk/crons.ts cronRegistry (30 * * * *)
      cf.app.cronHourly30 -[recovery]-> cf.coreDb 'finds products pending for 15+ minutes' {
        notes '''
          Fifteen minutes of grace, counted from when the product was made, so the sweep rarely races a send still in flight. At most 100 a firing, taken in no fixed order, so past 100 waiting each firing sends a different hundred.

          **No age or try ceiling on `pending`.** A product the consumer cannot finish (the page budget is spent, or the dead-letter mark throws) is sent again every hour, and each firing\'s report counts it, until the consumer runs. Then a failure past the first day goes straight to Gave up.
        '''
      }
      // source: src/modules/dispatch/scheduled.ts redispatchStalledEnrichments, redispatchEach
      cf.app.cronHourly30 -[recovery]-> cf.enrichmentQueue 'sends them again' {
        notes 'Safe to repeat: the consumer works only a `pending` product, and reuses a page stored in the last hour or not yet read.'
      }
    }
    loop 'at least once: up to 3 retries' {
      // source: src/modules/dispatch/queues.ts handleQueueBatch; wrangler.jsonc queues.consumers, max_retries (3)
      cf.enrichmentQueue -[async]-> cf.app.enrichment.consumer 'delivers EnrichJob'
      // source: src/modules/enrichment/consume.ts processEnrichJob
      cf.app.enrichment.consumer -> cf.coreDb 'reads the product, or stops'
      // source: src/modules/enrichment/consume.ts extractPending, latestSnapshot, REUSE_WINDOW_MS
      cf.app.enrichment.consumer -> cf.mediaBucket 'reads the page stored in the last hour, or not yet read'
    }
    opt 'every retry failed' {
      // source: wrangler.jsonc queues.consumers, max_retries, dead_letter_queue (3)
      cf.enrichmentQueue -[recovery]-> cf.enrichmentDlq 'dead-letters the job'
      // source: src/modules/dispatch/queues.ts handleQueueBatch (dialed-enrichment-dlq)
      cf.enrichmentDlq -[async]-> cf.app.enrichment.deadLetter 'delivers it'
      // source: src/modules/enrichment/consume.ts handleEnrichmentDlqBatch; src/modules/dispatch/queues.ts deliveries; src/lib/sql/queue-batch.ts deadLetterEach; wrangler.jsonc queues.consumers, max_retries (1 on the DLQ, no dead-letter queue of its own)
      cf.app.enrichment.deadLetter -[recovery]-> cf.coreDb 'marks the product failed, if still pending' {
        notes '''
          A retry that won before the dead letter arrived is never un-done. Inside the product\'s first day the failure is parked for the sweep, every delivery counted as a try; past it, it goes on the Desk\'s Gave up at once.

          **If it fails:** a throw fails the dead-letter batch, which retries once. After that the product stays `pending`, and the hourly sweep sends it again.
        '''
      }
    }
    opt 'failed, inside the product\'s first day, and under 6 tries' {
      // source: src/modules/dispatch/scheduled.ts redispatchStalledEnrichments, failedAndOwed; src/modules/enrichment/abandon.ts sweepOwed, ENRICHMENT_RETRY_WINDOW_S, ENRICHMENT_SWEEP_TRIES (6)
      cf.app.cronHourly30 -[recovery]-> cf.coreDb 'claims failed products back to pending' {
        notes '''
          A claim, not just a send: the consumer ignores a product that is not `pending`. Hourly inside the product\'s first day, while it has fewer than 6 tries: a dead letter counts 4 (one for each delivery), a failed fetch or an unreadable answer 1. Past the cap it waits out its day `failed`.

          The closet\'s link line says "retrying" by the same rule.
        '''
      }
      // source: src/modules/dispatch/scheduled.ts redispatchStalledEnrichments, redispatchEach
      cf.app.cronHourly30 -[recovery]-> cf.enrichmentQueue 'sends them again'
    }
    opt 'failed, and past the product\'s first day' {
      // source: src/modules/enrichment/abandon.ts listAbandonedEnrichments, ABANDONED_PER_FIRING (100)
      cf.app.cronHourly30 -[recovery]-> cf.coreDb 'lists it on the Desk\'s Gave up' {
        notes 'The system has stopped retrying, so a person is told. The daily digest reports it too. At most 100 a firing, oldest first; the rest wait for the next.'
      }
      // source: src/modules/ops/desk/gave-up.ts retryEnrichment
      operator -> cf.app.ops.deskRetry 'presses Retry'
      // source: src/modules/ops/desk/gave-up.ts retryEnrichment, retryFailedEnrichment (claims a failed product whatever its age); src/modules/enrichment/request.ts retryFailedEnrichment
      cf.app.ops.deskRetry -[recovery]-> cf.app.enrichment.request 'claims it and sends EnrichJob again' {
        notes 'The Desk can also re-run extraction over the stored page, with no fetch and no queue.'
      }
    }
  }
}
