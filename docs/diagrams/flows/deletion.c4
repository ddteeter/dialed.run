views {
  dynamic view deletionStory {
    title 'A runner deletes their account, and has a week to keep it'

    include
      runner with {
        description 'Asks to delete their account'
      }
    include
      cf.coreDb with {
        description 'The account_deletions row is the durable marker'
      }

    // source: src/modules/account/functions.ts requestDeletionFn; src/modules/account/data/deletion.ts requestAccountDeletion, refusal
    runner -> cf.app.account.deletionRequest 'asks to delete the account, and proves it is them' {
      notes '''
        A request that does not prove it is the runner changes nothing and says why.
      '''
    }
    // source: src/modules/account/data/deletion.ts requestAccountDeletion (db.batch, onConflictDoNothing, outboxInsertWhere), pendingDeletionOf; src/lib/contracts/garments.ts DELETION_GRACE_S; src/modules/ops/limits/rate-limit.ts DELETION_NOTICES_PER_DAY (3)
    cf.app.account.deletionRequest -> cf.coreDb 'writes the claim, signs out every session, and owes the email, in one batch' {
      notes '''
        **Guard: one claim a runner.** A second request keeps the first one\'s date, a week after it was asked.

        **Bounded.** 3 "delete scheduled" emails a day. Past that the deletion is scheduled all the same, and no email is owed.

        **This row is the recovery marker.** Nothing about the runner\'s entries is written: they leave the feed, profiles, search and the Call through safety\'s visibility rule, which reads the claim. So keeping the account brings everything back as it was.
      '''
    }
    // source: src/modules/account/data/deletion.ts requestAccountDeletion (effects.keepAlive, effects.settle), deletionEffectsFromEnv; src/modules/ops/owed-email/owed-email.ts settleOwedEmail
    cf.app.account.deletionRequest -[async]-> cf.app.ops.owedEmail 'sends "delete scheduled", after the response' {
      notes '''
        **Timing boundary: the request has answered.** The send goes on under waitUntil.

        **If it is lost:** the owed row stays, and an hourly drain sends it.
      '''
      navigateTo deletionRecovery
    }
    // source: src/modules/account/data/deletion.ts requestAccountDeletion (effects.purgeFor, runnerCacheTag); src/modules/ops/public-web/edge-purge.ts purgePublicPagesFor
    cf.app.account.deletionRequest -> cf.app.ops.publicWeb.purge 'purges every public page of the runner\'s' {
      notes '''
        One tag names them all. A public kit\'s photos follow the same path as any kit that stops being public.
      '''
    }
    // source: src/modules/account/data/deletion.ts requestAccountDeletion (account-deletion-strava); src/modules/runs/strava/oauth.ts disconnectStrava
    cf.app.account.deletionRequest -> cf.app.runs 'disconnects Strava' {
      notes '''
        **Degrade, don\'t fail.** A failure is reported, and the purge disconnects whatever is still connected.
      '''
    }
    // source: src/modules/account/data/deletion.ts requestAccountDeletion, leavingView
    runner <- cf.app.account.deletionRequest 'answers with the day it goes' {
      notes '''
        **Timing boundary: the request ends here,** and a week begins. The runner is signed out, and told the day in their home zone.
      '''
    }
    opt 'the runner signs in within the week and keeps it' {
      // source: src/modules/account/functions.ts keepAccountFn; src/modules/account/data/deletion.ts keepAccount
      runner -> cf.app.account.keep 'keeps the account'
      // source: src/modules/account/data/deletion.ts keepAccount (db.batch, purgeStartedAt)
      cf.app.account.keep -> cf.coreDb 'deletes the claim, only if the purge has not started' {
        notes '''
          **Guard: claim, then work.** Once the purge has claimed the account it owns it, and Keep is too late.
        '''
      }
    }
    // source: src/modules/dispatch/scheduled.ts runDailyDigest, liveUpkeep (purgeDueAccounts); src/modules/ops/desk/crons.ts cronRegistry (0 12 * * *)
    cf.app.cronDaily1200 -> cf.app.account.purge 'a week on, purges the account' {
      notes '''
        **Timing boundary: the week has passed.** The daily firing at 12:00 UTC purges what is due.
      '''
    }
    // source: src/modules/account/purge/purge.ts purgeDueAccounts, claimDue, PURGE_LEASE_S
    cf.app.account.purge -> cf.coreDb 'claims the account, and purges it step by step' {
      notes '''
        **Guard: claim, then work.** Once claimed, Keep is too late.
      '''
      navigateTo deletionPurge
    }
  }

  dynamic view deletionLinkStory {
    title 'A closed account is deleted through a link the Desk sends'

    include
      runner with {
        description 'Holds a closed account, so cannot sign in'
      }
    include
      cf.coreDb with {
        description 'The delete link row, then the account_deletions row'
      }

    // source: src/modules/safety/functions.ts sendDeletionLinkAction; src/modules/account/data/deletion-link.ts sendDeletionLink, closedAccountOf
    operator -> cf.app.safety.sendDeletionLink 'sends a closed account its deletion link' {
      notes '''
        Only a closed account with no deletion scheduled can be sent one, read on the primary.
      '''
    }
    // source: src/modules/account/verification/email-links.ts claimFreshEmailLink, LINK_TTL_S; src/lib/contracts/garments.ts DELETION_LINK_TTL_S
    cf.app.safety.sendDeletionLink -> cf.coreDb 'writes the link: its hash, for 7 days' {
      notes '''
        **Guard: one live link an account.** The write replaces only a link that ran out unused, so a second press sends nothing.
      '''
    }
    // source: src/modules/account/data/deletion-link.ts sendDeletionLink, deletionLinkUrl; src/modules/email/deliver.ts deliverEmail
    cf.app.safety.sendDeletionLink -> cf.app.email 'emails it to the account\'s own address, now' {
      notes '''
        **Not atomic with the write.** A failed send deletes the link, and the Desk reads NOT SENT and can press again. The link never rides the outbox.
      '''
    }
    // source: src/modules/account/functions.ts readDeletionLinkFn; src/modules/account/data/deletion-link.ts readDeletionLanding, spendableOrEnd
    runner -> cf.app.account.deletionLink 'opens the link: it asks, and spends nothing' {
      notes '''
        A link that ran out, was replaced, or was withdrawn by Reopen reads as LINK EXPIRED, whichever it was.
      '''
    }
    // source: src/modules/account/functions.ts confirmDeletionLinkFn; src/modules/account/data/deletion-link.ts confirmDeletionLink, landedOrReleased; src/modules/account/verification/email-links.ts didClaimEmailLink
    cf.app.account.deletionLink -> cf.coreDb 'claims the link, then writes the claim and owes the email, in one batch' {
      notes '''
        **Guard: claim, then work.** Two presses at once schedule once; the other reads already used.

        **Guard: still closed.** The claim is written only while the account is closed, so a Reopen in between schedules nothing.

        **If it fails:** the link is handed back, and the next press tries again.
      '''
    }
    // source: src/modules/account/data/deletion-link.ts confirmDeletionLink (effects.keepAlive, effects.settle); src/modules/ops/owed-email/owed-email.ts settleOwedEmail
    cf.app.account.deletionLink -[async]-> cf.app.ops.owedEmail 'sends "delete scheduled", after the response' {
      notes '''
        **Timing boundary: the press has answered.** The send goes on under waitUntil, with no way to keep the account: a reply instead.

        **If it is lost:** the owed row stays, and an hourly drain sends it.
      '''
      navigateTo deletionRecovery
    }
    // source: src/modules/account/data/deletion-link.ts confirmDeletionLink (deletion-link-strava); src/modules/runs/strava/oauth.ts disconnectStrava
    cf.app.account.deletionLink -> cf.app.runs 'disconnects Strava' {
      notes '''
        **Degrade, don\'t fail.** A failure is reported, and the purge disconnects whatever is still connected.
      '''
    }
    // source: src/modules/account/data/deletion-link.ts confirmDeletionLink, deletionDay
    runner <- cf.app.account.deletionLink 'answers with the day it goes' {
      notes '''
        **Timing boundary: the press ends here,** and a week begins. Signing in stays closed, and Reopen can no longer undo it.
      '''
    }
    // source: src/modules/dispatch/scheduled.ts runDailyDigest, liveUpkeep (purgeDueAccounts); src/modules/ops/desk/crons.ts cronRegistry (0 12 * * *)
    cf.app.cronDaily1200 -> cf.app.account.purge 'a week on, purges the account' {
      notes '''
        **Timing boundary: the week has passed.** The purge is the one every deletion ends in.
      '''
      navigateTo deletionPurge
    }
  }

  dynamic view deletionForAge {
    title 'The Desk closes an account for age, and its deletion is scheduled'

    include
      cf.coreDb with {
        description 'The account_deletions row is the durable marker'
      }

    // source: src/modules/safety/functions.ts banUserAction; src/modules/safety/rules/contracts.ts isAgeClosure, closureRules
    operator -> cf.app.safety.closeAccount 'closes the account: Under 18' {
      notes '''
        No link is sent: the Desk made this call.
      '''
    }
    // source: src/modules/safety/runners/bans.ts banUser (db.batch); src/modules/account/data/deletion-link.ts ageClosure; src/lib/contracts/garments.ts DELETION_GRACE_S
    cf.app.safety.closeAccount -> cf.coreDb 'closes it, signs it out, writes the claim and owes the age email, in one batch' {
      notes '''
        **Guard: one claim a runner.** A runner who had asked already keeps their own date and cause, and the email says that date. The claim is marked as closed for age either way.
      '''
    }
    // source: src/modules/safety/functions.ts banUserAction; src/modules/ops/owed-email/owed-email.ts settleOwedEmail
    cf.app.safety.closeAccount -> cf.app.ops.owedEmail 'sends the age email' {
      notes '''
        **If it fails:** the owed row stays, and an hourly drain sends it.
      '''
    }
    opt 'the Desk reopens it within the week' {
      // source: src/modules/safety/functions.ts unbanUserAction; src/modules/safety/runners/bans.ts unbanUser
      operator -> cf.app.safety.reopenAccount 'reopens the account'
      // source: src/modules/safety/runners/bans.ts unbanUser (db.batch); src/modules/account/data/deletion-link.ts reopenHeldBy, reopenDeletionWrites
      cf.app.safety.reopenAccount -> cf.coreDb 'lifts the ban, cancels the deletion and withdraws any link, in one batch' {
        notes '''
          **Guard: held by a choice.** A deletion the runner chose, or a purge under way, keeps the account closed, and nothing is written.
        '''
      }
    }
    // source: src/modules/dispatch/scheduled.ts runDailyDigest, liveUpkeep (purgeDueAccounts); src/modules/ops/desk/crons.ts cronRegistry (0 12 * * *)
    cf.app.cronDaily1200 -> cf.app.account.purge 'a week on, purges the account' {
      navigateTo deletionPurge
    }
  }

  dynamic view deletionPurge {
    title 'An account is purged at the end of its week'

    include
      cf.coreDb with {
        description 'The account_deletions row is the durable marker'
      }

    // source: src/modules/dispatch/scheduled.ts runDailyDigest (account-deletion), PURGED_LAST; src/modules/account/purge/purge.ts purgeDueAccounts, PURGE_BUDGET_MS, PURGE_RUNS_PER_FIRING
    cf.app.cronDaily1200 -> cf.app.account.purge 'purges the accounts past their week, after the rest of the daily upkeep' {
      notes '''
        **Bounded.** It runs last, after the digest email and the sweeps. It keeps claiming for 5 minutes at most, and deletes at most 8,000 runs a firing across every account it claims.
      '''
      navigateTo deletionRecovery
    }
    // source: src/modules/account/purge/purge.ts claimDue, claimable, due, liveHold, PURGE_PER_ROUND (3), PURGE_LEASE_S
    cf.app.account.purge -> cf.coreDb 'claims up to 3 due accounts, and signs out every purge under way' {
      notes '''
        **Guard: claim, then work.** Only the rows this statement moved are this firing\'s. A claim is held an hour, so two overlapping firings never share one.

        An account a live copyright hold names is not claimed: the held material is evidence until the Desk settles it.

        A runner who signed in during the week and never kept the account is signed out here, so nothing can be written behind the purge.
      '''
    }
    // source: src/modules/account/purge/purge.ts purgeAccount, livePurgeDeps (revokeStrava); src/modules/runs/strava/oauth.ts disconnectStrava
    cf.app.account.purge -> cf.app.runs 'disconnects Strava, if still connected' {
      notes '''
        A connection the request could not close is closed here, before anything else of the runner\'s goes.
      '''
    }
    // source: src/modules/account/purge/purge.ts forgetScreenings; src/modules/safety/review/review.ts settleOpenReviews
    cf.app.account.purge -> cf.coreDb 'forgets what the screener said of their photos, and settles open reviews' {
      notes '''
        Before the photos go, because the photos are how these rows are found.
      '''
    }
    // source: src/modules/account/purge/purge.ts didDeleteEveryRun, PURGE_RUNS_PAGE; src/modules/weather/index.ts forgetManualBands
    cf.app.account.purge -> cf.app.weather 'forgets the condition bands of the next page of runs' {
      notes '''
        **Bounded.** A page is 400 runs, in id order, and the bands go in one batch. Before the page\'s runs, because once they are gone nothing names these rows.

        **Not atomic with the next step.** The bands live in the weather database, a second system; a page that stops between them is read again next time.
      '''
    }
    // source: src/modules/account/purge/purge.ts didDeleteEveryRun; src/modules/feed/entries/retract.ts deleteRunsThrough, runStatements, commit
    cf.app.account.purge -> cf.app.feed 'deletes that page of runs and their entries, page after page' {
      notes '''
        With their kit, tags, reactions, photos and notifications, in one batch. Their photos and run files are left to the listings below, so nothing is owed a file at a time.

        **If the firing\'s bound runs out:** the account keeps its claim, nothing is reported as failed, and the digest says how many purges continue on the next firing.
      '''
      navigateTo deletionRecovery
    }
    // source: src/modules/account/purge/purge.ts purgeAccount; src/modules/feed/entries/retract.ts deleteRuns, mediaDebts
    cf.app.account.purge -> cf.app.feed 'owes the runner\'s entry photos as one prefix' {
      notes '''
        Once every run is gone. No run file is owed here: the listing below deletes them.
      '''
    }
    // source: src/modules/account/purge/purge.ts deleteCloset (photo_delete, settleOutbox); src/modules/ops/outbox/storage-handlers.ts reconcileItemPhotos
    cf.app.account.purge -> cf.coreDb 'deletes the closet and any upload that never became a run, and owes the closet\'s photos as one prefix' {
      notes '''
        Retire, don\'t delete does not apply: every entry is already gone. One listing of the runner\'s garment prefix clears every photo at once, as their entry photos are cleared.

        **If it fails:** the owed row stays, and the daily drain clears the prefix.
      '''
    }
    // source: src/modules/account/purge/purge.ts deleteStoredFiles; src/lib/sql/r2-pages.ts listedPages
    cf.app.account.purge -> cf.importsBucket 'lists and deletes the run files and export ZIPs' {
      notes '''
        Found by listing the runner\'s prefixes, not from rows, so a file whose row was never written goes too.
      '''
    }
    // source: src/modules/account/purge/purge.ts deleteAccountRows (db.batch, namedByOwnColumn, usernameHistory, forgetMaker); src/modules/products/service.ts forgetMaker
    cf.app.account.purge -> cf.coreDb 'deletes everything else, then the account and its claim, in one batch' {
      notes '''
        **Guard: the claim goes last,** with the account, so a claim that exists is always a purge still owed.

        Kept on purpose: shared products, with the maker they name replaced, reports about the runner\'s content, moderation records, the reports they filed with the reporter replaced, and the handle, which is never released.
      '''
    }
  }

  dynamic view deletionRecovery {
    title 'When a deletion\'s step is lost'

    include
      cf.coreDb with {
        description 'The account_deletions row is the durable marker'
      }

    try {
      // source: src/modules/account/purge/purge.ts purgeEach, purgeAccount
      cf.app.cronDaily1200 -> cf.app.account.purge 'purges a claimed account step by step'
    }
    catch 'a step fails, or the Worker stops' {
      // source: src/modules/account/purge/purge.ts purgeEach (account-purge)
      cf.app.account.purge -> sentry 'reports the failure, with the runner\'s id'
      // source: src/modules/account/purge/purge.ts purgeDueAccounts (anomalies), purgeEach
      cf.app.cronDaily1200 -> sentry 'names the purges that stopped part way in the digest'
      // source: src/modules/account/purge/purge.ts claimDue, due, PURGE_LEASE_S
      cf.app.cronDaily1200 -[recovery]-> cf.app.account.purge 'takes the claim again the next day' {
        notes '''
          Every step deletes what is left, so the next firing does only what the failure left undone. A claim a purge failed on goes behind every one not yet tried, so it cannot keep the others waiting.
        '''
      }
    }
    opt 'the firing\'s run bound runs out part way through an account' {
      // source: src/modules/account/purge/purge.ts purgeDueAccounts (unfinished), didDeleteEveryRun
      cf.app.cronDaily1200 -> sentry 'names how many purges continue on the next firing' {
        notes '''
          The claim is kept, and the next firing past its lease takes it again and goes on from the runs that are left.
        '''
      }
    }
    opt 'more are due than one firing claims' {
      // source: src/modules/account/purge/purge.ts purgeDueAccounts (waiting, past their date)
      cf.app.cronDaily1200 -> sentry 'names how many wait for the next firing'
    }
    opt 'a copyright hold names the account' {
      // source: src/modules/account/purge/purge.ts purgeDueAccounts (held, dueButHeld), liveHold
      cf.app.cronDaily1200 -> sentry 'names the deletions waiting on a hold' {
        notes '''
          The hold\'s own end lets the next firing in.
        '''
      }
    }
    opt 'an owed delete or email was not worked at once' {
      // source: src/modules/dispatch/scheduled.ts runDailyDigest (drainOutbox), drainOwedEmail; src/modules/ops/outbox/outbox.ts drainOutbox
      cf.app.cronDaily1200 -[recovery]-> cf.app.ops.outbox 'drains the owed photo and file deletes' {
        notes '''
          The daily drain works every kind. The "delete scheduled" email is also drained hourly. The outbox\'s own view walks the drain.
        '''
      }
    }
  }
}
