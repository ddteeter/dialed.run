# SA-L10. An install runs a dependency's install script only when
# package.json's `allowScripts` names the package; any other script fails
# the install (npm 11.19). engine-strict makes package.json's `engines`
# floor a failed install too, so an npm too old to know
# strict-allow-scripts stops instead of running every script.
strict-allow-scripts=true
engine-strict=true
