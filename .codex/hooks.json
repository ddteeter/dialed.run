{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import('guardrails-core/cli')\" guardrails session-start",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import('guardrails-core/cli')\" guardrails session-end",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import('guardrails-core/cli')\" guardrails scope-check --dialect=codex",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|Shell|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import('guardrails-core/cli')\" guardrails gate --mode=pretooluse --dialect=codex",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import('guardrails-core/cli')\" guardrails scope-check --dialect=codex",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import('guardrails-core/cli')\" guardrails autofix",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/drewteeter/.agents/skills/impeccable/scripts/impeccable' ] || '/Users/drewteeter/.agents/skills/impeccable/scripts/impeccable' hook",
            "commandWindows": "if exist \"/Users/drewteeter/.agents/skills/impeccable/scripts/impeccable.cmd\" (\"/Users/drewteeter/.agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import('guardrails-core/cli')\" guardrails gate --mode=stop --dialect=codex",
            "timeout": 300
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/drewteeter/.agents/skills/impeccable/scripts/impeccable' ] || '/Users/drewteeter/.agents/skills/impeccable/scripts/impeccable' hook",
            "commandWindows": "if exist \"/Users/drewteeter/.agents/skills/impeccable/scripts/impeccable.cmd\" (\"/Users/drewteeter/.agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
